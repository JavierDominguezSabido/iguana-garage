# Copiar a .env.maintenance.local (ignorado). Nunca versionar valores reales.
# URL/clave publicable se leen de .env.local; sin service_role.
IGUANA_MAINTENANCE_EMAIL=
IGUANA_MAINTENANCE_PASSWORD=
# Solo al autorizar --apply: referencia exacta del proyecto destino, no una clave.
IGUANA_VARIANTS_ALLOW_WRITE=
