# Configuración diseñada para navegador; guardar valores reales en .env.local (ignorado).
# Solo clave sb_publishable_*. Nunca service_role, sb_secret_* ni contraseña en NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Único contacto del taller. Número real confirmado, E.164 con +, sin espacios.
# Sin valor válido la web muestra contacto pendiente, sin inventar WhatsApp/tel.
IGUANA_WHATSAPP_NUMBER=
